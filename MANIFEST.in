include README.md PYPI_README.md CHANGELOG.md CONTRIBUTORS.md CITATION.cff
include LICENSE NOTICE LICENSE.md
include API_REFERENCE.md ARCHITECTURE.md MODEL_SPECIFICATION.md IMPLEMENTATION_NOTES.md
include mkdocs.yml .readthedocs.yaml INICIAR_GUI.cmd
recursive-include src *.py py.typed
recursive-include tests *.py
recursive-include examples *.py *.json
recursive-include scripts *.py
recursive-include docs *.md *.txt *.png *.svg *.js *.css
recursive-include benchmarks/e01 *.py *.json *.md
recursive-include benchmarks/e01b *.py *.json *.md
prune audit
prune PAPER_ENVSOFT
prune REGISTRATION_PREPARATION
prune benchmarks/reproduction_20261120
prune benchmarks/data_catalog
global-exclude __pycache__ *.py[cod]
